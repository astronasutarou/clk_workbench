# Simplified readout for a 30-pixel one-dimensional integrating image sensor
# Ten frames perform a global reset and integration, then read each pixel
# through a two-phase serial transfer and sample sequence
$FRAME_COUNT    9
$PIXEL_COUNT    29
$FRAME_COUNTER  0x20
$PIXEL_COUNTER  0x21
$RETURN         0x22

load $FRAME_COUNTER $FRAME_COUNT
@FRAME outp &RESET
       outp &INTEGRATE
       load $PIXEL_COUNTER $PIXEL_COUNT
@PIXEL subj $RETURN @READ_PIXEL
       cjmp $PIXEL_COUNTER @PIXEL
       outp &FRAME_END
       cjmp $FRAME_COUNTER @FRAME
       halt

@READ_PIXEL outp &TRANSFER
            outp &SAMPLE
            retn $RETURN

START_BIT_DATA
&RESET bit   4  00000000000000000000000000000000
       bit   8  00000000000000000000000000000001
       bit   4  00000000000000000000000000000000
       endb

&INTEGRATE bit  96  00000000000000000000000000000010
           bit   4  00000000000000000000000000000000
           endb

&TRANSFER bit  2  00000000000000000000000000000100
          bit  2  00000000000000000000000000001000
          bit  2  00000000000000000000000000000100
          bit  2  00000000000000000000000000000000
          endb

&SAMPLE bit  3  00000000000000000000000000010000
        bit  3  00000000000000000000000000000000
        endb

&FRAME_END bit  6  00000000000000000000000000100000
           bit  6  00000000000000000000000000000000
           endb
