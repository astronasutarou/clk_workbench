# Ten-bit walking high clock
$COUNT    99
$COUNTER  0x20

load $COUNTER $COUNT
@LOOP outp &PATTERN
      cjmp $COUNTER @LOOP
      halt

START_BIT_DATA
&PATTERN bit  4  00000000000000000000000000000001
         bit  4  00000000000000000000000000000011
         bit  4  00000000000000000000000000000111
         bit  4  00000000000000000000000000001111
         bit  4  00000000000000000000000000011111
         bit  4  00000000000000000000000000111111
         bit  4  00000000000000000000000001111110
         bit  4  00000000000000000000000011111000
         bit  4  00000000000000000000000111110000
         bit  4  00000000000000000000001111100000
         bit  4  00000000000000000000001111000000
         bit  4  00000000000000000000001110000000
         bit  4  00000000000000000000001100000000
         bit  4  00000000000000000000001000000000
         endb
