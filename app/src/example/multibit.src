# Ten-bit walking high clock
$COUNT    99
$COUNTER  0x20

load $COUNTER $COUNT
@LOOP outp &WALKING_HIGH
      cjmp $COUNTER @LOOP
      halt

START_BIT_DATA
&WALKING_HIGH bit  4  00000000000000000000000000000001
              bit  4  00000000000000000000000000000010
              bit  4  00000000000000000000000000000100
              bit  4  00000000000000000000000000001000
              bit  4  00000000000000000000000000010000
              bit  4  00000000000000000000000000100000
              bit  4  00000000000000000000000001000000
              bit  4  00000000000000000000000010000000
              bit  4  00000000000000000000000100000000
              bit  4  00000000000000000000001000000000
              endb
