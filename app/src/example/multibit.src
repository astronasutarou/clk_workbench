# Non-overlapping two-phase clock
$COUNT    15
$COUNTER  0x20

load $COUNTER $COUNT
@LOOP outp &TWO_PHASE
      cjmp $COUNTER @LOOP
      halt

START_BIT_DATA
&TWO_PHASE bit  4  00000000000000000000000000000000
           bit  4  00000000000000000000000000000001
           bit  2  00000000000000000000000000000000
           bit  4  00000000000000000000000000000010
           bit  2  00000000000000000000000000000000
           endb
