# Repeated blink waveform
$COUNT    99
$COUNTER  0x20

load $COUNTER $COUNT
@LOOP outp &PATTERN
      cjmp $COUNTER @LOOP
      halt

START_BIT_DATA
&PATTERN bit  18  00000000000000000000000000000000
         bit   4  00000000000000000000000000000100
         bit   4  00000000000000000000000000010100
         bit   4  00000000000000000000000000000100
         bit  18  00000000000000000000000000000000
         endb
