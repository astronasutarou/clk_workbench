# Event-controlled mode switch
# Add an event such as: load $MODE 1
$COUNT    31
$CLEAR    0
$COUNTER  0x20
$MODE     0x21

load $COUNTER $COUNT
load $MODE $CLEAR
@LOOP outp &RUN
      bjmp $MODE @EVENT_SIGNAL
      cjmp $COUNTER @LOOP
      halt

@EVENT_SIGNAL outp &EVENT_MARKER
              halt

START_BIT_DATA
&RUN bit  6  00000000000000000000000000000000
     bit  6  00000000000000000000000000000001
     endb

&EVENT_MARKER bit  12  00000000000000000000000000000011
              bit  12  00000000000000000000000000000000
              endb
